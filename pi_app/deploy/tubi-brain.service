[Unit]
Description=Tubi brain (pi_app: LLM + TTS + speaker + ESP32)
# Starts right after the website; it retries its websocket (and every cloud call) on its own if the network is late.
After=network.target tubi-web.service
Wants=tubi-web.service

[Service]
User=maxwelllokshin
# relative paths (config/snacks.json, tools/quiz_result.json) resolve from here
WorkingDirectory=/home/maxwelllokshin/tubi_ros_env/pi_app
EnvironmentFile=/home/maxwelllokshin/tubi_ros_env/pi_app/secrets.env
ExecStart=/home/maxwelllokshin/tubi_ros_env/pi_app/.venv/bin/python -m pi_app.teammate_client
Restart=always
RestartSec=3
# serial port + audio device access
SupplementaryGroups=dialout audio

[Install]
WantedBy=multi-user.target
