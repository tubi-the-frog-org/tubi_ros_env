# Copy to secrets.env (gitignored) and fill in real values.
# Loaded via systemd EnvironmentFile= in production; export manually for local dev.
# Never commit secrets.env, and never log any of these values above DEBUG.

# Magic-user type and level assessment. OpenAI-compatible.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5-nano

# TTS call (speech audio). ElevenLabs.
TTS_API_KEY=
TTS_BASE_URL=https://api.elevenlabs.io/v1
TTS_MODEL=eleven_turbo_v2_5
# Stock "Adam" voice by default -- swap for a cloned voice_id once one exists.
TTS_VOICE_ID=pNInz6obpgDQGcFmaJgB

# The website's websocket hub (teammate_client.py connects out to this).
# ?role=teammate is required: it's how the server knows to send this client
# session:start / transcript / session:end (browsers never get those).
WEBSITE_WS_URL=ws://localhost:3000/?role=teammate

# Serial device for the ESP32 (e.g. /dev/ttyUSB0 on the Pi). Leave unset
# to run with no ESP32 attached (NullEspLink -- logs/no-ops instead).
# One-wire motor link, no USB: Pi pin 12 (GPIO18) -> motor ESP32 RX0, plus a shared GND. Needs pigpiod.
# Takes priority over ESP32_SERIAL_PORT.
ESP32_SOFT_TX_GPIO=
ESP32_SERIAL_PORT=

# ---- ESP32 hardware ---------------------------------------------------------------------------------
# ONE-BOARD layout (esp32_firmware/src/tubi_one_board): the Pi's UART goes straight to ONE ESP32 that plays
# the audio AND runs the servos. Put the SAME device in both ports and the Pi shares the one connection.
# Wiring: Pi pin 8 (GPIO14) -> ESP32 GPIO16, Pi pin 10 (GPIO15) <- GPIO17, Pi pin 12 (GPIO18) <- GPIO18, GND.
#   AUDIO_SERIAL_PORT=/dev/serial0
#   ESP32_SERIAL_PORT=/dev/serial0
#   AUDIO_ACK_BYTE=6          # the one-board firmware acks a finished clip with 0x06 (the S3 bridge used 'D' = 68)
#
# OLDER layouts: audio over the S3 bridge (AUDIO_SERIAL_PORT=/dev/serial0, ack 'D' is the default) and the
# motor board on USB (ESP32_SERIAL_PORT=/dev/serial/by-path/...), or no AUDIO_SERIAL_PORT to use the Pi speaker.
AUDIO_SERIAL_PORT=
ESP32_SERIAL_PORT=
AUDIO_ACK_BYTE=
# Optional one-wire motor link (soft serial on a spare Pi GPIO, needs pigpiod); wins over ESP32_SERIAL_PORT.
ESP32_SOFT_TX_GPIO=
