# Copy to secrets.env (gitignored) and fill in real values.
# Loaded via systemd EnvironmentFile= in production; export manually for local dev.
# Never commit secrets.env, and never log any of these values above DEBUG.

# Decision call (snack choice + reply text).
LLM_API_KEY=

# TTS call (speech audio). Can be the same key as LLM_API_KEY if both
# point at OpenAI -- kept separate so a different provider is a drop-in swap.
TTS_API_KEY=

# Bearer token /speak requires in its Authorization header.
WEB_BRIDGE_TOKEN=
