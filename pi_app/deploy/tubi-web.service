[Unit]
Description=Tubi website (Express + WebSocket hub)
After=network-online.target
Wants=network-online.target

[Service]
User=maxwelllokshin
WorkingDirectory=/home/maxwelllokshin/tubi_ros_env/website
Environment=NODE_ENV=production
Environment=PORT=3000
# STT_API_KEY falls back to LLM_API_KEY from here: speech-to-text runs in the cloud (no Whisper on the Pi)
EnvironmentFile=/home/maxwelllokshin/tubi_ros_env/pi_app/secrets.env
ExecStart=/usr/bin/node server/index.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
