# Copy to secrets.env (gitignored) and fill in real values.
# Loaded via systemd EnvironmentFile= in production; export manually for local dev.
# Never commit secrets.env, and never log any of these values above DEBUG.

# Decision call (snack choice + reply text). OpenAI-compatible.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5-nano

# TTS call (speech audio). ElevenLabs.
TTS_API_KEY=
TTS_BASE_URL=https://api.elevenlabs.io/v1
TTS_MODEL=eleven_turbo_v2_5
# Stock "Adam" voice by default -- swap for a cloned voice_id once one exists.
TTS_VOICE_ID=pNInz6obpgDQGcFmaJgB

# The website's websocket hub (teammate_client.py connects out to this).
WEBSITE_WS_URL=ws://localhost:3000

# Serial device for the ESP32 (e.g. /dev/ttyUSB0 on the Pi). Leave unset
# to run with no ESP32 attached (NullEspLink -- logs/no-ops instead).
ESP32_SERIAL_PORT=
