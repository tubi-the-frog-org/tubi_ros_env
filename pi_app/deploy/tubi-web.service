[Unit]
Description=Tubi website (Express + WebSocket hub)
# No network-online dependency: the site is local, and waiting for it can stall startup for a minute
# (e.g. with an Ethernet cable plugged in and no DHCP server).
After=network.target

[Service]
User=maxwelllokshin
WorkingDirectory=/home/maxwelllokshin/tubi_ros_env/website
Environment=NODE_ENV=production
Environment=PORT=3000
# STT_API_KEY falls back to LLM_API_KEY from here: speech-to-text runs in the cloud (no Whisper on the Pi)
EnvironmentFile=/home/maxwelllokshin/tubi_ros_env/pi_app/secrets.env
ExecStart=/usr/bin/node server/index.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
