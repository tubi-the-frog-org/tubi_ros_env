# Copy to secrets.env (gitignored) and fill in real values.
# Loaded via systemd EnvironmentFile= in production; export manually for local dev.
# Never commit secrets.env, and never log any of these values above DEBUG.

# Cloud LLM provider (brain node) -- OpenAI-compatible API key.
LLM_API_KEY=

# TTS provider (speech node, not yet built).
TTS_API_KEY=

# Bearer token web_bridge requires on incoming /speak requests (web_bridge, not yet built).
WEB_BRIDGE_TOKEN=
